const INTERP1_PEEK_LANE0_OFFSET: u32 = 0x000000e0
const INTERP1_PEEK_LANE0_INTERP1_PEEK_LANE0_MASK: u32 = 0xffffffff
const INTERP1_PEEK_LANE0_INTERP1_PEEK_LANE0_SHIFT: u32 = 0

