const INTERP1_PEEK_LANE1_INTERP1_PEEK_LANE1_MASK: u32 = 0xffffffff
const INTERP1_PEEK_LANE1_INTERP1_PEEK_LANE1_SHIFT: u32 = 0

// Read FULL result, without altering any internal state (PEEK).
const INTERP1_PEEK_FULL_OFFSET: u32 = 0x000000e8
const INTERP1_PEEK_FULL_INTERP1_PEEK_FULL_MASK: u32 = 0xffffffff
const INTERP1_PEEK_FULL_INTERP1_PEEK_FULL_SHIFT: u32 = 0

// Control register for lane 0
const INTERP1_CTRL_LANE0_OFFSET: u32 = 0x000000ec
const INTERP1_CTRL_LANE0_OVERF_MASK: u32 = 0x02000000
const INTERP1_CTRL_LANE0_OVERF_SHIFT: u32 = 25
const INTERP1_CTRL_LANE0_OVERF1_MASK: u32 = 0x01000000
const INTERP1_CTRL_LANE0_OVERF1_SHIFT: u32 = 24
