// Single-cycle IO block Provides core-local and inter-core hardware for the two processors, with
// single-cycle access.

module sh.sysl.rp2040.sio

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0xd0000000

// Processor core identifier
const CPUID_OFFSET: u32 = 0x00000000
const CPUID_CPUID_MASK: u32 = 0xffffffff
const CPUID_CPUID_SHIFT: u32 = 0

// Input value for GPIO pins
const GPIO_IN_OFFSET: u32 = 0x00000004
const GPIO_IN_GPIO_IN_MASK: u32 = 0x3fffffff
const GPIO_IN_GPIO_IN_SHIFT: u32 = 0

// Input value for QSPI pins
const GPIO_HI_IN_OFFSET: u32 = 0x00000008
const GPIO_HI_IN_GPIO_HI_IN_MASK: u32 = 0x0000003f
const GPIO_HI_IN_GPIO_HI_IN_SHIFT: u32 = 0

// GPIO output value
const GPIO_OUT_OFFSET: u32 = 0x00000010
const GPIO_OUT_GPIO_OUT_MASK: u32 = 0x3fffffff
const GPIO_OUT_GPIO_OUT_SHIFT: u32 = 0

// GPIO output value set
const GPIO_OUT_SET_OFFSET: u32 = 0x00000014
const GPIO_OUT_SET_GPIO_OUT_SET_MASK: u32 = 0x3fffffff
const GPIO_OUT_SET_GPIO_OUT_SET_SHIFT: u32 = 0

// GPIO output value clear
const GPIO_OUT_CLR_OFFSET: u32 = 0x00000018
const GPIO_OUT_CLR_GPIO_OUT_CLR_MASK: u32 = 0x3fffffff
const GPIO_OUT_CLR_GPIO_OUT_CLR_SHIFT: u32 = 0

// GPIO output value XOR
const GPIO_OUT_XOR_OFFSET: u32 = 0x0000001c
const GPIO_OUT_XOR_GPIO_OUT_XOR_MASK: u32 = 0x3fffffff
const GPIO_OUT_XOR_GPIO_OUT_XOR_SHIFT: u32 = 0

// GPIO output enable
const GPIO_OE_OFFSET: u32 = 0x00000020
const GPIO_OE_GPIO_OE_MASK: u32 = 0x3fffffff
const GPIO_OE_GPIO_OE_SHIFT: u32 = 0

// GPIO output enable set
const GPIO_OE_SET_OFFSET: u32 = 0x00000024
const GPIO_OE_SET_GPIO_OE_SET_MASK: u32 = 0x3fffffff
const GPIO_OE_SET_GPIO_OE_SET_SHIFT: u32 = 0

// GPIO output enable clear
const GPIO_OE_CLR_OFFSET: u32 = 0x00000028
const GPIO_OE_CLR_GPIO_OE_CLR_MASK: u32 = 0x3fffffff
const GPIO_OE_CLR_GPIO_OE_CLR_SHIFT: u32 = 0

// GPIO output enable XOR
const GPIO_OE_XOR_OFFSET: u32 = 0x0000002c
const GPIO_OE_XOR_GPIO_OE_XOR_MASK: u32 = 0x3fffffff
const GPIO_OE_XOR_GPIO_OE_XOR_SHIFT: u32 = 0

// QSPI output value
const GPIO_HI_OUT_OFFSET: u32 = 0x00000030
const GPIO_HI_OUT_GPIO_HI_OUT_MASK: u32 = 0x0000003f
const GPIO_HI_OUT_GPIO_HI_OUT_SHIFT: u32 = 0

// QSPI output value set
const GPIO_HI_OUT_SET_OFFSET: u32 = 0x00000034
const GPIO_HI_OUT_SET_GPIO_HI_OUT_SET_MASK: u32 = 0x0000003f
const GPIO_HI_OUT_SET_GPIO_HI_OUT_SET_SHIFT: u32 = 0

// QSPI output value clear
const GPIO_HI_OUT_CLR_OFFSET: u32 = 0x00000038
const GPIO_HI_OUT_CLR_GPIO_HI_OUT_CLR_MASK: u32 = 0x0000003f
const GPIO_HI_OUT_CLR_GPIO_HI_OUT_CLR_SHIFT: u32 = 0

// QSPI output value XOR
const GPIO_HI_OUT_XOR_OFFSET: u32 = 0x0000003c
const GPIO_HI_OUT_XOR_GPIO_HI_OUT_XOR_MASK: u32 = 0x0000003f
const GPIO_HI_OUT_XOR_GPIO_HI_OUT_XOR_SHIFT: u32 = 0

// QSPI output enable
const GPIO_HI_OE_OFFSET: u32 = 0x00000040
const GPIO_HI_OE_GPIO_HI_OE_MASK: u32 = 0x0000003f
const GPIO_HI_OE_GPIO_HI_OE_SHIFT: u32 = 0

// QSPI output enable set
const GPIO_HI_OE_SET_OFFSET: u32 = 0x00000044
const GPIO_HI_OE_SET_GPIO_HI_OE_SET_MASK: u32 = 0x0000003f
const GPIO_HI_OE_SET_GPIO_HI_OE_SET_SHIFT: u32 = 0

// QSPI output enable clear
const GPIO_HI_OE_CLR_OFFSET: u32 = 0x00000048
const GPIO_HI_OE_CLR_GPIO_HI_OE_CLR_MASK: u32 = 0x0000003f
const GPIO_HI_OE_CLR_GPIO_HI_OE_CLR_SHIFT: u32 = 0

// QSPI output enable XOR
const GPIO_HI_OE_XOR_OFFSET: u32 = 0x0000004c
const GPIO_HI_OE_XOR_GPIO_HI_OE_XOR_MASK: u32 = 0x0000003f
const GPIO_HI_OE_XOR_GPIO_HI_OE_XOR_SHIFT: u32 = 0

// Status register for inter-core FIFOs (mailboxes). There is one FIFO in the core 0 -> core 1
// direction, and one core 1 -> core 0. Both are 32 bits wide and 8 words deep. Core 0 can see the
// read side of the 1->0 FIFO (RX), and the write side of 0->1 FIFO (TX). Core 1 can see the read
// side of the 0->1 FIFO (RX), and the write side of 1->0 FIFO (TX). The SIO IRQ for each core is
// the logical OR of the VLD, WOF and ROE fields of its FIFO_ST register.
const FIFO_ST_OFFSET: u32 = 0x00000050
const FIFO_ST_ROE_MASK: u32 = 0x00000008
const FIFO_ST_ROE_SHIFT: u32 = 3
const FIFO_ST_WOF_MASK: u32 = 0x00000004
const FIFO_ST_WOF_SHIFT: u32 = 2
const FIFO_ST_RDY_MASK: u32 = 0x00000002
const FIFO_ST_RDY_SHIFT: u32 = 1
const FIFO_ST_VLD_MASK: u32 = 0x00000001
const FIFO_ST_VLD_SHIFT: u32 = 0

// Write access to this core's TX FIFO
const FIFO_WR_OFFSET: u32 = 0x00000054
const FIFO_WR_FIFO_WR_MASK: u32 = 0xffffffff
const FIFO_WR_FIFO_WR_SHIFT: u32 = 0

// Read access to this core's RX FIFO
const FIFO_RD_OFFSET: u32 = 0x00000058
const FIFO_RD_FIFO_RD_MASK: u32 = 0xffffffff
const FIFO_RD_FIFO_RD_SHIFT: u32 = 0

// Spinlock state A bitmap containing the state of all 32 spinlocks (1=locked). Mainly intended for
// debugging.
const SPINLOCK_ST_OFFSET: u32 = 0x0000005c
const SPINLOCK_ST_SPINLOCK_ST_MASK: u32 = 0xffffffff
const SPINLOCK_ST_SPINLOCK_ST_SHIFT: u32 = 0

// Divider unsigned dividend Write to the DIVIDEND operand of the divider, i.e. the p in `p / q`.
// Any operand write starts a new calculation. The results appear in QUOTIENT, REMAINDER.
// UDIVIDEND/SDIVIDEND are aliases of the same internal register. The U alias starts an unsigned
// calculation, and the S alias starts a signed calculation.
const DIV_UDIVIDEND_OFFSET: u32 = 0x00000060
const DIV_UDIVIDEND_DIV_UDIVIDEND_MASK: u32 = 0xffffffff
const DIV_UDIVIDEND_DIV_UDIVIDEND_SHIFT: u32 = 0

// Divider unsigned divisor Write to the DIVISOR operand of the divider, i.e. the q in `p / q`. Any
// operand write starts a new calculation. The results appear in QUOTIENT, REMAINDER.
// UDIVISOR/SDIVISOR are aliases of the same internal register. The U alias starts an unsigned
// calculation, and the S alias starts a signed calculation.
const DIV_UDIVISOR_OFFSET: u32 = 0x00000064
const DIV_UDIVISOR_DIV_UDIVISOR_MASK: u32 = 0xffffffff
const DIV_UDIVISOR_DIV_UDIVISOR_SHIFT: u32 = 0

// Divider signed dividend The same as UDIVIDEND, but starts a signed calculation, rather than
// unsigned.
const DIV_SDIVIDEND_OFFSET: u32 = 0x00000068
const DIV_SDIVIDEND_DIV_SDIVIDEND_MASK: u32 = 0xffffffff
const DIV_SDIVIDEND_DIV_SDIVIDEND_SHIFT: u32 = 0

// Divider signed divisor The same as UDIVISOR, but starts a signed calculation, rather than
// unsigned.
const DIV_SDIVISOR_OFFSET: u32 = 0x0000006c
const DIV_SDIVISOR_DIV_SDIVISOR_MASK: u32 = 0xffffffff
const DIV_SDIVISOR_DIV_SDIVISOR_SHIFT: u32 = 0

// Divider result quotient The result of `DIVIDEND / DIVISOR` (division). Contents undefined while
// CSR_READY is low. For signed calculations, QUOTIENT is negative when the signs of DIVIDEND and
// DIVISOR differ. This register can be written to directly, for context save/restore purposes.
// This halts any in-progress calculation and sets the CSR_READY and CSR_DIRTY flags. Reading from
// QUOTIENT clears the CSR_DIRTY flag, so should read results in the order REMAINDER, QUOTIENT if
// CSR_DIRTY is used.
const DIV_QUOTIENT_OFFSET: u32 = 0x00000070
const DIV_QUOTIENT_DIV_QUOTIENT_MASK: u32 = 0xffffffff
const DIV_QUOTIENT_DIV_QUOTIENT_SHIFT: u32 = 0

// Divider result remainder The result of `DIVIDEND % DIVISOR` (modulo). Contents undefined while
// CSR_READY is low. For signed calculations, REMAINDER is negative only when DIVIDEND is negative.
// This register can be written to directly, for context save/restore purposes. This halts any
// in-progress calculation and sets the CSR_READY and CSR_DIRTY flags.
const DIV_REMAINDER_OFFSET: u32 = 0x00000074
const DIV_REMAINDER_DIV_REMAINDER_MASK: u32 = 0xffffffff
const DIV_REMAINDER_DIV_REMAINDER_SHIFT: u32 = 0

// Control and status register for divider.
const DIV_CSR_OFFSET: u32 = 0x00000078
const DIV_CSR_DIRTY_MASK: u32 = 0x00000002
const DIV_CSR_DIRTY_SHIFT: u32 = 1
const DIV_CSR_READY_MASK: u32 = 0x00000001
const DIV_CSR_READY_SHIFT: u32 = 0

// Read/write access to accumulator 0
const INTERP0_ACCUM0_OFFSET: u32 = 0x00000080
const INTERP0_ACCUM0_INTERP0_ACCUM0_MASK: u32 = 0xffffffff
const INTERP0_ACCUM0_INTERP0_ACCUM0_SHIFT: u32 = 0

// Read/write access to accumulator 1
const INTERP0_ACCUM1_OFFSET: u32 = 0x00000084
const INTERP0_ACCUM1_INTERP0_ACCUM1_MASK: u32 = 0xffffffff
const INTERP0_ACCUM1_INTERP0_ACCUM1_SHIFT: u32 = 0

// Read/write access to BASE0 register.
const INTERP0_BASE0_OFFSET: u32 = 0x00000088
const INTERP0_BASE0_INTERP0_BASE0_MASK: u32 = 0xffffffff
const INTERP0_BASE0_INTERP0_BASE0_SHIFT: u32 = 0

// Read/write access to BASE1 register.
const INTERP0_BASE1_OFFSET: u32 = 0x0000008c
const INTERP0_BASE1_INTERP0_BASE1_MASK: u32 = 0xffffffff
const INTERP0_BASE1_INTERP0_BASE1_SHIFT: u32 = 0

// Read/write access to BASE2 register.
const INTERP0_BASE2_OFFSET: u32 = 0x00000090
const INTERP0_BASE2_INTERP0_BASE2_MASK: u32 = 0xffffffff
const INTERP0_BASE2_INTERP0_BASE2_SHIFT: u32 = 0

// Read LANE0 result, and simultaneously write lane results to both accumulators (POP).
const INTERP0_POP_LANE0_OFFSET: u32 = 0x00000094
const INTERP0_POP_LANE0_INTERP0_POP_LANE0_MASK: u32 = 0xffffffff
const INTERP0_POP_LANE0_INTERP0_POP_LANE0_SHIFT: u32 = 0

// Read LANE1 result, and simultaneously write lane results to both accumulators (POP).
const INTERP0_POP_LANE1_OFFSET: u32 = 0x00000098
const INTERP0_POP_LANE1_INTERP0_POP_LANE1_MASK: u32 = 0xffffffff
const INTERP0_POP_LANE1_INTERP0_POP_LANE1_SHIFT: u32 = 0

// Read FULL result, and simultaneously write lane results to both accumulators (POP).
const INTERP0_POP_FULL_OFFSET: u32 = 0x0000009c
const INTERP0_POP_FULL_INTERP0_POP_FULL_MASK: u32 = 0xffffffff
const INTERP0_POP_FULL_INTERP0_POP_FULL_SHIFT: u32 = 0

// Read LANE0 result, without altering any internal state (PEEK).
const INTERP0_PEEK_LANE0_OFFSET: u32 = 0x000000a0
const INTERP0_PEEK_LANE0_INTERP0_PEEK_LANE0_MASK: u32 = 0xffffffff
const INTERP0_PEEK_LANE0_INTERP0_PEEK_LANE0_SHIFT: u32 = 0

// Read LANE1 result, without altering any internal state (PEEK).
const INTERP0_PEEK_LANE1_OFFSET: u32 = 0x000000a4
const INTERP0_PEEK_LANE1_INTERP0_PEEK_LANE1_MASK: u32 = 0xffffffff
const INTERP0_PEEK_LANE1_INTERP0_PEEK_LANE1_SHIFT: u32 = 0

// Read FULL result, without altering any internal state (PEEK).
const INTERP0_PEEK_FULL_OFFSET: u32 = 0x000000a8
const INTERP0_PEEK_FULL_INTERP0_PEEK_FULL_MASK: u32 = 0xffffffff
const INTERP0_PEEK_FULL_INTERP0_PEEK_FULL_SHIFT: u32 = 0

// Control register for lane 0
const INTERP0_CTRL_LANE0_OFFSET: u32 = 0x000000ac
const INTERP0_CTRL_LANE0_OVERF_MASK: u32 = 0x02000000
const INTERP0_CTRL_LANE0_OVERF_SHIFT: u32 = 25
const INTERP0_CTRL_LANE0_OVERF1_MASK: u32 = 0x01000000
const INTERP0_CTRL_LANE0_OVERF1_SHIFT: u32 = 24
const INTERP0_CTRL_LANE0_OVERF0_MASK: u32 = 0x00800000
const INTERP0_CTRL_LANE0_OVERF0_SHIFT: u32 = 23
const INTERP0_CTRL_LANE0_BLEND_MASK: u32 = 0x00200000
const INTERP0_CTRL_LANE0_BLEND_SHIFT: u32 = 21
const INTERP0_CTRL_LANE0_FORCE_MSB_MASK: u32 = 0x00180000
const INTERP0_CTRL_LANE0_FORCE_MSB_SHIFT: u32 = 19
const INTERP0_CTRL_LANE0_ADD_RAW_MASK: u32 = 0x00040000
const INTERP0_CTRL_LANE0_ADD_RAW_SHIFT: u32 = 18
const INTERP0_CTRL_LANE0_CROSS_RESULT_MASK: u32 = 0x00020000
const INTERP0_CTRL_LANE0_CROSS_RESULT_SHIFT: u32 = 17
const INTERP0_CTRL_LANE0_CROSS_INPUT_MASK: u32 = 0x00010000
const INTERP0_CTRL_LANE0_CROSS_INPUT_SHIFT: u32 = 16
const INTERP0_CTRL_LANE0_SIGNED_MASK: u32 = 0x00008000
const INTERP0_CTRL_LANE0_SIGNED_SHIFT: u32 = 15
const INTERP0_CTRL_LANE0_MASK_MSB_MASK: u32 = 0x00007c00
const INTERP0_CTRL_LANE0_MASK_MSB_SHIFT: u32 = 10
const INTERP0_CTRL_LANE0_MASK_LSB_MASK: u32 = 0x000003e0
const INTERP0_CTRL_LANE0_MASK_LSB_SHIFT: u32 = 5
const INTERP0_CTRL_LANE0_SHIFT_MASK: u32 = 0x0000001f
const INTERP0_CTRL_LANE0_SHIFT_SHIFT: u32 = 0

// Control register for lane 1
const INTERP0_CTRL_LANE1_OFFSET: u32 = 0x000000b0
const INTERP0_CTRL_LANE1_FORCE_MSB_MASK: u32 = 0x00180000
const INTERP0_CTRL_LANE1_FORCE_MSB_SHIFT: u32 = 19
const INTERP0_CTRL_LANE1_ADD_RAW_MASK: u32 = 0x00040000
const INTERP0_CTRL_LANE1_ADD_RAW_SHIFT: u32 = 18
const INTERP0_CTRL_LANE1_CROSS_RESULT_MASK: u32 = 0x00020000
const INTERP0_CTRL_LANE1_CROSS_RESULT_SHIFT: u32 = 17
const INTERP0_CTRL_LANE1_CROSS_INPUT_MASK: u32 = 0x00010000
const INTERP0_CTRL_LANE1_CROSS_INPUT_SHIFT: u32 = 16
const INTERP0_CTRL_LANE1_SIGNED_MASK: u32 = 0x00008000
const INTERP0_CTRL_LANE1_SIGNED_SHIFT: u32 = 15
const INTERP0_CTRL_LANE1_MASK_MSB_MASK: u32 = 0x00007c00
const INTERP0_CTRL_LANE1_MASK_MSB_SHIFT: u32 = 10
const INTERP0_CTRL_LANE1_MASK_LSB_MASK: u32 = 0x000003e0
const INTERP0_CTRL_LANE1_MASK_LSB_SHIFT: u32 = 5
const INTERP0_CTRL_LANE1_SHIFT_MASK: u32 = 0x0000001f
const INTERP0_CTRL_LANE1_SHIFT_SHIFT: u32 = 0

// Values written here are atomically added to ACCUM0 Reading yields lane 0's raw shift and mask
// value (BASE0 not added).
const INTERP0_ACCUM0_ADD_OFFSET: u32 = 0x000000b4
const INTERP0_ACCUM0_ADD_INTERP0_ACCUM0_ADD_MASK: u32 = 0x00ffffff
const INTERP0_ACCUM0_ADD_INTERP0_ACCUM0_ADD_SHIFT: u32 = 0

// Values written here are atomically added to ACCUM1 Reading yields lane 1's raw shift and mask
// value (BASE1 not added).
const INTERP0_ACCUM1_ADD_OFFSET: u32 = 0x000000b8
const INTERP0_ACCUM1_ADD_INTERP0_ACCUM1_ADD_MASK: u32 = 0x00ffffff
const INTERP0_ACCUM1_ADD_INTERP0_ACCUM1_ADD_SHIFT: u32 = 0

// On write, the lower 16 bits go to BASE0, upper bits to BASE1 simultaneously. Each half is
// sign-extended to 32 bits if that lane's SIGNED flag is set.
const INTERP0_BASE_1AND0_OFFSET: u32 = 0x000000bc
const INTERP0_BASE_1AND0_INTERP0_BASE_1AND0_MASK: u32 = 0xffffffff
const INTERP0_BASE_1AND0_INTERP0_BASE_1AND0_SHIFT: u32 = 0

// Read/write access to accumulator 0
const INTERP1_ACCUM0_OFFSET: u32 = 0x000000c0
const INTERP1_ACCUM0_INTERP1_ACCUM0_MASK: u32 = 0xffffffff
const INTERP1_ACCUM0_INTERP1_ACCUM0_SHIFT: u32 = 0

// Read/write access to accumulator 1
const INTERP1_ACCUM1_OFFSET: u32 = 0x000000c4
const INTERP1_ACCUM1_INTERP1_ACCUM1_MASK: u32 = 0xffffffff
const INTERP1_ACCUM1_INTERP1_ACCUM1_SHIFT: u32 = 0

// Read/write access to BASE0 register.
const INTERP1_BASE0_OFFSET: u32 = 0x000000c8
const INTERP1_BASE0_INTERP1_BASE0_MASK: u32 = 0xffffffff
const INTERP1_BASE0_INTERP1_BASE0_SHIFT: u32 = 0

// Read/write access to BASE1 register.
const INTERP1_BASE1_OFFSET: u32 = 0x000000cc
const INTERP1_BASE1_INTERP1_BASE1_MASK: u32 = 0xffffffff
const INTERP1_BASE1_INTERP1_BASE1_SHIFT: u32 = 0

// Read/write access to BASE2 register.
const INTERP1_BASE2_OFFSET: u32 = 0x000000d0
const INTERP1_BASE2_INTERP1_BASE2_MASK: u32 = 0xffffffff
const INTERP1_BASE2_INTERP1_BASE2_SHIFT: u32 = 0

// Read LANE0 result, and simultaneously write lane results to both accumulators (POP).
const INTERP1_POP_LANE0_OFFSET: u32 = 0x000000d4
const INTERP1_POP_LANE0_INTERP1_POP_LANE0_MASK: u32 = 0xffffffff
const INTERP1_POP_LANE0_INTERP1_POP_LANE0_SHIFT: u32 = 0

// Read LANE1 result, and simultaneously write lane results to both accumulators (POP).
const INTERP1_POP_LANE1_OFFSET: u32 = 0x000000d8
const INTERP1_POP_LANE1_INTERP1_POP_LANE1_MASK: u32 = 0xffffffff
const INTERP1_POP_LANE1_INTERP1_POP_LANE1_SHIFT: u32 = 0

// Read FULL result, and simultaneously write lane results to both accumulators (POP).
const INTERP1_POP_FULL_OFFSET: u32 = 0x000000dc
const INTERP1_POP_FULL_INTERP1_POP_FULL_MASK: u32 = 0xffffffff
const INTERP1_POP_FULL_INTERP1_POP_FULL_SHIFT: u32 = 0

